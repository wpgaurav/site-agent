#: includes/class-abilities.php:564
msgid "Current path relative to wp-content."
msgstr ""

#: includes/class-abilities.php:565
msgid "New path relative to wp-content. Its directory must exist."
msgstr ""

#: includes/class-abilities.php:580
msgid "Execute PHP"
msgstr ""

#: includes/class-abilities.php:581
msgid "Run PHP statements in the loaded WordPress request with full server privileges; not sandboxed. No PHP tags and no exit or die. Echo output and a JSON-serializable return value are captured; errors include their message and line."
msgstr ""

#: includes/class-abilities.php:584
msgid "PHP statements without <?php, for example: return get_option( \"blogname\" );"
