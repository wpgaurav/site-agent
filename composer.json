{
  "name": "gauravtiwari/site-agent",
  "description": "Privately distributed WordPress developer access through MCP.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0",
    "wordpress/mcp-adapter": "dev-trunk"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "config": {
    "allow-plugins": {
      "automattic/jetpack-autoloader": false,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": { "php": "8.0.30" },
    "sort-packages": true
  },
  "repositories": [
    { "type": "vcs", "url": "https://github.com/WordPress/mcp-adapter" }
  ],
  "scripts": {
    "runtime": "@php bin/build-runtime.php",
    "lint": "@php bin/lint.php",
    "test": "phpunit",
    "check": [ "@lint", "@test" ]
  }
}
